{
  "name": "mir2x",
  "version-string": "0.1.0",
  "dependencies": [
    "argh",
    "asio",
    "cereal",
    "g3log",
    "libpng",
    "libpopcnt",
    "lua",
    "lz4",
    "parallel-hashmap",
    "sdl3",
    "sdl3-gfx",
    {
      "name": "sdl3-image",
      "features": [
        "png"
      ]
    },
    {
      "name": "sdl3-mixer",
      "features": [
        "mpg123"
      ]
    },
    "sdl3-ttf",
    "sol2",
    "tiny-aes-c",
    "tinyxml2",
    "utfcpp",
    "zlib",
    "zstd",
    {
      "name": "argh",
      "host": true
    },
    {
      "name": "zstd",
      "host": true
    }
  ],
  "default-features": [
    "desktop"
  ],
  "features": {
    "desktop": {
      "description": "Server, tools, tests and the client's embedded pinyin IME, the Android client-only build turns it off with VCPKG_MANIFEST_NO_DEFAULT_FEATURES",
      "dependencies": [
        "catch2",
        "fltk",
        "libpinyin",
        "sqlitecpp"
      ]
    }
  }
}
